{
    "compilerOptions": {
      "target": "ES2020",
      "module": "ES2020",
      "strict": true,
      "esModuleInterop": true,
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true,
      "moduleResolution": "node",
      "declaration": true,
      "declarationMap": true,
      "sourceMap": true,
      "outDir": "./dist",
      "baseUrl": "./src",
      "paths": {
        "@/*": ["./*"]
      },
      "plugins": [
        { "name": "typescript-plugin-css-modules" }
      ]
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules"]
  }